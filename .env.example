REDIS_NAME=redis_server
REDIS_PORT=6379
REDIS_EXTERNAL_PORT=6379
REDIS_HOST_BIND=127.0.0.1
REDIS_USERNAME=user
REDIS_PASSWORD="pass123" # Do not use the ">" character at the beginning of the password.
REDIS_PASSWORD_TYPE=">" # >(plain) or #(hash)
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY="allkeys-lru"
